<Window x:Class="ParamBridge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParamBridge – Excel Sync" Width="1150" Height="720" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F6F7F9" FontFamily="Segoe UI" FontSize="12" Foreground="#1C2330">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ParamBridge;component/UI/Theme/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate x:Key="ParamItem">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Tag="{Binding Badge}">
                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DataType}" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/ParamBridge;component/Resources/Icons/bridge_light_32.png" Width="24" Height="24" Margin="0,0,8,0"/>
                    <TextBlock Text="ParamBridge" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock Text="Profile" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                    <ComboBox Width="200" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding CurrentProfile}"/>
                    <Button Style="{StaticResource PbIcon}" Content="&#xE74E;" ToolTip="Save profile" Command="{Binding SaveProfileCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" IsIndeterminate="True" Foreground="{StaticResource Accent}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rows:" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                    <RadioButton Content="By instance" IsChecked="True" Margin="0,0,12,0"/>
                    <RadioButton Content="By type" IsChecked="{Binding SortByType}" Margin="0,0,20,0"/>
                    <CheckBox Content="Single worksheet" IsChecked="{Binding SingleSheet}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PbButton}" Command="{Binding ImportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Glyphs}" Text="&#xE8B5;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Import…"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PbPrimary}" Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Glyphs}" Text="&#xEDE1;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export…"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <DockPanel Margin="16,8,16,0">
            <TabControl x:Name="Tabs" DockPanel.Dock="Top" SelectionChanged="Tabs_SelectionChanged" BorderThickness="0" Background="Transparent" Height="30">
                <TabItem Header="Model"/>
                <TabItem Header="Annotation"/>
                <TabItem Header="Elements"/>
                <TabItem Header="Schedules"/>
                <TabItem Header="Spatial"/>
            </TabControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="220"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: source navigator -->
                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="SCOPE" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="ScopeModel" Content="Model" IsChecked="True" Checked="Scope_Checked" Margin="0,0,10,0"/>
                                <RadioButton x:Name="ScopeView" Content="Active view" Checked="Scope_Checked" Margin="0,0,10,0"/>
                                <RadioButton x:Name="ScopeSel" Content="Selection" Checked="Scope_Checked"/>
                            </StackPanel>
                            <TextBlock Text="CATEGORIES" Style="{StaticResource SectionTitle}"/>
                            <TextBox Style="{StaticResource PbSearch}" Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search categories"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding CategoriesView}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Width="250">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource TextMuted}"/>
                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Available -->
                <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <ToggleButton Content="INST" IsChecked="{Binding ShowInstance}" Margin="2,0" Padding="6,1"/>
                                <ToggleButton Content="TYPE" IsChecked="{Binding ShowType}" Margin="2,0" Padding="6,1"/>
                                <ToggleButton Content="RO" IsChecked="{Binding ShowReadOnly}" Margin="2,0" Padding="6,1"/>
                            </StackPanel>
                            <TextBlock Text="AVAILABLE PARAMETERS" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource PbSearch}" Text="{Binding ParamSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <ListBox ItemsSource="{Binding AvailableView}" SelectedItem="{Binding AvailableSelection}"
                                 ItemTemplate="{StaticResource ParamItem}" HorizontalContentAlignment="Stretch" BorderThickness="0"
                                 MouseDoubleClick="Available_DoubleClick"/>
                    </DockPanel>
                </Border>

                <!-- Move buttons -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0">
                    <Button Style="{StaticResource PbIcon}" Content="&#xE76C;" ToolTip="Add" Command="{Binding AddCommand}" Margin="0,2"/>
                    <Button Style="{StaticResource PbIcon}" Content="&#xE76B;" ToolTip="Remove" Command="{Binding RemoveCommand}" Margin="0,2"/>
                    <Button Style="{StaticResource PbIcon}" Content="&#xEB9D;" ToolTip="Add all" Command="{Binding AddAllCommand}" Margin="0,10,0,2"/>
                    <Button Style="{StaticResource PbIcon}" Content="&#xEB9E;" ToolTip="Remove all" Command="{Binding RemoveAllCommand}" Margin="0,2"/>
                </StackPanel>

                <!-- Selected -->
                <Border Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SELECTED (EXCEL COLUMN ORDER)" Style="{StaticResource SectionTitle}"/>
                        <ListBox ItemsSource="{Binding Selected}" SelectedItem="{Binding SelectedSelection}"
                                 ItemTemplate="{StaticResource ParamItem}" HorizontalContentAlignment="Stretch" BorderThickness="0"
                                 MouseDoubleClick="Selected_DoubleClick"/>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource PbIcon}" Content="&#xE70E;" ToolTip="Move up" Command="{Binding MoveUpCommand}" Margin="0,2"/>
                    <Button Style="{StaticResource PbIcon}" Content="&#xE70D;" ToolTip="Move down" Command="{Binding MoveDownCommand}" Margin="0,2"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
