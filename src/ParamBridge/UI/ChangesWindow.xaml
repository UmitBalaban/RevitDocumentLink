<Window x:Class="ParamBridge.UI.ChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParamBridge – review changes" Width="1050" Height="620" WindowStartupLocation="CenterOwner"
        Background="#F6F7F9" FontFamily="Segoe UI" FontSize="12" Foreground="#1C2330" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ParamBridge;component/UI/Theme/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Showing" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                <ComboBox Width="140" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"/>
            </StackPanel>
            <TextBlock Text="{Binding Counters}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PbButton}" Content="Cancel" IsCancel="True"/>
            <Button Style="{StaticResource PbPrimary}" Content="Apply selected" Click="Apply_Click"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}" Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Border}" RowHeight="26">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Error">
                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Id" Binding="{Binding ElementId}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Old" Binding="{Binding OldValue}" IsReadOnly="True" Width="120" Foreground="#6B7380"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewValue}" IsReadOnly="True" Width="120" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
