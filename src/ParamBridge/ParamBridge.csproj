<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>ParamBridge</RootNamespace>
    <AssemblyName>ParamBridge</AssemblyName>
    <Version>0.1.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DeployToRevit Condition="'$(DeployToRevit)' == ''">true</DeployToRevit>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.png" />
    <None Update="ParamBridge.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copies the build output to %AppData%\Autodesk\Revit\Addins\<ver>\ -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true' And '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <AddinRoot>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinRoot>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.addin" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetDir)ParamBridge.addin" DestinationFolder="$(AddinRoot)" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(AddinRoot)\ParamBridge\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
